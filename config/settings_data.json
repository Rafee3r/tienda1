offset_y":20,"btn_animation":true,"color_scheme":"accent-1"}},"cart-drawer":{"type":"cart-drawer","blocks":{"custom_liquid_nhEQFP":{"type":"custom_liquid","settings":{"position":"body","custom_liquid":"<div id=\"hc-cc-root\"><\/div>\n<style>\n.hc-cc{display:flex;flex-wrap:wrap;gap:8px;margin:8px 0 4px;position:relative;z-index:6}\n.hc-cc b{width:100%;font:700 12px\/1.2 inherit;color:#111}\n.hc-cc button{width:42px;height:42px;padding:0;border:1px solid #d9d9d9;border-radius:10px;overflow:hidden;background:#f3f3f3;cursor:pointer}\n.hc-cc button img{width:100%;height:100%;object-fit:cover;display:block;pointer-events:none}\n.hc-cc button:hover{border-color:#111}\n.hc-cc button.is-current{border:2px solid #111;cursor:default}\n.hc-cc.is-busy{opacity:.45;pointer-events:none}\n<\/style>\n<script>\n(function(){\n  if (window.__hcCC11) return;\n  window.__hcCC11 = true;\n\n  var root = (window.Shopify && Shopify.routes && Shopify.routes.root) ? Shopify.routes.root : '\/';\n  var HANDLE = 'estrellita';\n  var painted = false;\n\n  function getJSON(url){\n    return new Promise(function(ok, fail){\n      var x = new XMLHttpRequest();\n      x.open('GET', url);\n      x.timeout = 8000;\n      x.onload = function(){ try { ok(JSON.parse(x.responseText)); } catch(e){ fail(e); } };\n      x.onerror = x.ontimeout = function(){ fail(new Error('timeout')); };\n      x.send();\n    });\n  }\n  function postJSON(url, data){\n    return new Promise(function(ok, fail){\n      var x = new XMLHttpRequest();\n      x.open('POST', url);\n      x.setRequestHeader('Content-Type','application\/json');\n      x.timeout = 8000;\n      x.onload = function(){\n        var j={}; try { j=JSON.parse(x.responseText||'{}'); } catch(e){}\n        if (x.status>=200 && x.status<300) ok(j); else fail(new Error(j.description||('HTTP '+x.status)));\n      };\n      x.onerror = x.ontimeout = function(){ fail(new Error('timeout')); };\n      x.send(JSON.stringify(data||{}));\n    });\n  }\n\n  function colorIndex(p){\n    var opts = p.options || [];\n    for (var i=0;i<opts.length;i++){\n      var name = typeof opts[i]==='string' ? opts[i] : (opts[i] && opts[i].name) || '';\n      if (\/color|colour|tono\/i.test(name)) return i;\n    }\n    return opts.length>1 ? 1 : 0;\n  }\n  function opt(v,i){ return (v.options && v.options[i]) || v['option'+(i+1)] || ''; }\n  function abs(src){ return !src ? '' : (src.indexOf('\/\/')===0 ? 'https:'+src : src); }\n\n  function mount(){\n    return document.getElementById('hc-cc-root');\n  }\n\n  function paint(){\n    var boxRoot = mount();\n    if (!boxRoot || boxRoot.querySelector('.hc-cc')) return;\n\n    Promise.all([\n      getJSON(root + 'cart.js'),\n      getJSON(root + 'products\/' + HANDLE + '.js')\n    ]).then(function(res){\n      var c = res[0], p = res[1];\n      var item = (c.items || []).find(function(it){ return it.handle === HANDLE; });\n      if (!item) return;\n      var idx = colorIndex(p);\n      var cur = p.variants.find(function(v){ return Number(v.id)===Number(item.variant_id); });\n      if (!cur) return;\n      if (boxRoot.querySelector('.hc-cc')) return;\n\n      var box = document.createElement('div');\n      box.className = 'hc-cc';\n      var lab = document.createElement('b');\n      lab.textContent = 'Cambiar color';\n      box.appendChild(lab);\n\n      var seen = {};\n      p.variants.forEach(function(v){\n        var color = opt(v, idx);\n        if (!color || seen[color]) return;\n        seen[color] = true;\n        var btn = document.createElement('button');\n        btn.type = 'button';\n        btn.title = color;\n        btn.setAttribute('data-id', String(v.id));\n        btn.setAttribute('data-qty', String(item.quantity || 1));\n        if (Number(v.id)===Number(cur.id)) btn.className = 'is-current';\n        var src = v.featured_image && v.featured_image.src;\n        if (src){\n          var im = document.createElement('img');\n          im.src = abs(src);\n          im.alt = color;\n          btn.appendChild(im);\n        } else btn.textContent = color;\n        box.appendChild(btn);\n      });\n      boxRoot.appendChild(box);\n      painted = true;\n    }).catch(function(){});\n  }\n\n  function goCheckout(id, qty){\n    var box = document.querySelector('.hc-cc');\n    if (box) box.classList.add('is-busy');\n    var q = Number(qty || 1);\n    var vid = Number(id);\n\n    postJSON(root + 'cart\/clear.js', {})\n      .catch(function(){ return null; })\n      .then(function(){\n        window.location.href = root + 'cart\/' + vid + ':' + q + '?checkout';\n      });\n  }\n\n  document.addEventListener('click', function(e){\n    if (e.target.closest('[class*=\"priorit\"], [class*=\"upsell\"], [class*=\"envio\"], [class*=\"Envio\"]')) return;\n    var btn = e.target.closest('#hc-cc-root button, .hc-cc button');\n    if (!btn) return;\n    if (btn.classList.contains('is-current')) return;\n    e.preventDefault();\n    e.stopPropagation();\n    goCheckout(btn.getAttribute('data-id'), btn.getAttribute('data-qty'));\n  }, true);\n\n  paint();\n  setTimeout(paint, 400);\n  setTimeout(paint, 1200);\n})();\n<\/script>"}},"6269cf6e-8e24-4068-8e2a-35bb4addad4e":{"type":"countdown_timer","settings":{"timer_text":"<strong>Alta demanda, <\/strong>reservado durante<strong> [timer]<\/strong>","timer_duration":300,"font_size":"1.4","color_scheme":"inverse","margin_top":0,"margin_bottom":15}},"097b7b4f-c0b8-4073-a06b-e6d49a5aad20":{"type":"cart_items","settings":{"image_size":"20","image_link":false,"title_size":"1.5","title_link":false,"displayed_variants":"compact","prices_position":"right","displayed_compare_prices":"product","price_color":"accent-1","compare_price_color":"text","display_single_item_prices":true,"enable_savings":true,"savings_text":"<strong>(Ahorras [amount])<\/strong>","savings_color":"text","quantity_font_size":14,"quantity_container_padding":0,"quantity_corner_radius":6,"quantity_border_width":1,"quantity_border_color":"#787878","quantity_container_c