<style>
  .bd-home{--blue:#4F8FE1;--ink:#111;--muted:#666;--bg:#fafafa;--max:1120px;font-family:inherit;color:var(--ink);background:#fff}
  .bd-home *{box-sizing:border-box}
  .bd-home img{max-width:100%;display:block}
  .bd-wrap{width:min(var(--max),calc(100% - 32px));margin:0 auto}
  .bd-bar{background:#111;color:#fff;text-align:center;padding:10px 16px;font-size:13px}
  .bd-hero{padding:48px 0 28px;text-align:center}
  .bd-hero h1{font-size:clamp(32px,6vw,64px);line-height:1.05;margin:0 0 16px;letter-spacing:-.03em}
  .bd-hero p{font-size:18px;color:var(--muted);margin:0 0 24px}
  .bd-btn{display:inline-block;background:var(--blue);color:#fff;text-decoration:none;padding:14px 28px;border-radius:999px;font-weight:700}
  .bd-hero-img{margin-top:32px;border-radius:24px;overflow:hidden;background:#f3f3f3;min-height:220px}
  .bd-hero-img img{width:100%;height:auto;object-fit:cover}
  .bd-trust{display:flex;flex-wrap:wrap;justify-content:center;gap:10px 18px;padding:22px 16px;border-top:1px solid #eee;border-bottom:1px solid #eee;font-size:14px}
  .bd-sec{padding:64px 0}
  .bd-sec h2{font-size:clamp(26px,4vw,42px);line-height:1.15;margin:0 0 28px;text-align:center;letter-spacing:-.03em}
  .bd-colors img,.bd-product img{width:100%;border-radius:20px;background:#f6f6f6}
  .bd-grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .bd-card{background:var(--bg);border-radius:20px;overflow:hidden}
  .bd-card img{width:100%;height:240px;object-fit:cover;background:#eee}
  .bd-card div{padding:18px}
  .bd-card h3{margin:0 0 8px;font-size:20px}
  .bd-card p{margin:0;color:var(--muted)}
  .bd-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;text-align:center}
  .bd-steps b{display:block;font-size:28px;color:var(--blue);margin-bottom:6px}
  .bd-ugc{padding:0 0 64px}
  .bd-ugc img{width:100%;min-height:180px;object-fit:cover;background:#111}
  .bd-quotes{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
  .bd-quote{background:var(--bg);border-radius:20px;padding:22px;white-space:pre-line;line-height:1.45;font-size:15px}
  .bd-product{display:grid;grid-template-columns:1.1fr .9fr;gap:28px;align-items:center}
  .bd-price{font-size:28px;font-weight:800;margin:8px 0}
  .bd-old{color:#999;text-decoration:line-through;font-size:16px;font-weight:500;margin-left:8px}
  .bd-note{color:var(--muted);margin:0 0 18px}
  .bd-close{text-align:center;background:#111;color:#fff;padding:72px 16px}
  .bd-close h2{color:#fff;margin-bottom:12px}
  .bd-close p{color:#cfcfcf;margin:0 0 22px}
  @media(max-width:800px){
    .bd-grid3,.bd-quotes,.bd-product,.bd-steps{grid-template-columns:1fr}
    .bd-sec{padding:48px 0}
  }
</style>

<div class="bd-home">
  {% if section.settings.bar != blank %}
    <div class="bd-bar">{{ section.settings.bar }}</div>
  {% endif %}

  <section class="bd-hero">
    <div class="bd-wrap">
      <h1>{{ section.settings.hero_title }}</h1>
      <p>{{ section.settings.hero_text }}</p>
      {% if section.settings.hero_btn != blank %}
        <a class="bd-btn" href="/products/estrellita">{{ section.settings.hero_btn }}</a>
      {% endif %}
      {% if section.settings.img_hero %}
        <div class="bd-hero-img">
          {{ section.settings.img_hero | image_url: width: 1800 | image_tag: loading: 'eager', alt: section.settings.hero_title }}
        </div>
      {% endif %}
    </div>
  </section>

  <div class="bd-trust">
    <span>{{ section.settings.trust }}</span>
  </div>

  <section class="bd-sec">
    <div class="bd-wrap">
      <h2>{{ section.settings.colors_title }}</h2>
      {% if section.settings.img_colores %}
        <a href="/products/estrellita">
          {{ section.settings.img_colores | image_url: width: 1800 | image_tag: loading: 'lazy', alt: section.settings.colors_title }}
        </a>
      {% endif %}
    </div>
  </section>

  <section class="bd-sec">
    <div class="bd-wrap">
      <h2>{{ section.settings.why_title }}</h2>
      <div class="bd-grid3">
        <article class="bd-card">
          {% if section.settings.img_foto %}
            {{ section.settings.img_foto | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.why_1_title }}
          {% endif %}
          <div>
            <h3>{{ section.settings.why_1_title }}</h3>
            <p>{{ section.settings.why_1_text }}</p>
          </div>
        </article>
        <article class="bd-card">
          {% if section.settings.img_siesta %}
            {{ section.settings.img_siesta | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.why_2_title }}
          {% endif %}
          <div>
            <h3>{{ section.settings.why_2_title }}</h3>
            <p>{{ section.settings.why_2_text }}</p>
          </div>
        </article>
        <article class="bd-card">
          {% if section.settings.img_regalo %}
            {{ section.settings.img_regalo | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.why_3_title }}
          {% endif %}
          <div>
            <h3>{{ section.settings.why_3_title }}</h3>
            <p>{{ section.settings.why_3_text }}</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="bd-sec">
    <div class="bd-wrap">
      <h2>{{ section.settings.steps_title }}</h2>
      <div class="bd-steps">
        <div><b>1</b>{{ section.settings.step_1 }}</div>
        <div><b>2</b>{{ section.settings.step_2 }}</div>
        <div><b>3</b>{{ section.settings.step_3 }}</div>
        <div><b>4</b>{{ section.settings.step_4 }}</div>
      </div>
    </div>
  </section>

  {% if section.settings.img_ugc %}
    <section class="bd-ugc">
      {{ section.settings.img_ugc | image_url: width: 2000 | image_tag: loading: 'lazy', alt: 'beludu' }}
    </section>
  {% endif %}

  <section class="bd-sec">
    <div class="bd-wrap">
      <h2>{{ section.settings.quotes_title }}</h2>
      <div class="bd-quotes">
        <div class="bd-quote">{{ section.settings.quote_1 }}</div>
        <div class="bd-quote">{{ section.settings.quote_2 }}</div>
        <div class="bd-quote">{{ section.settings.quote_3 }}</div>
      </div>
    </div>
  </section>

  <section class="bd-sec">
    <div class="bd-wrap bd-product">
      {% if section.settings.img_producto %}
        {{ section.settings.img_producto | image_url: width: 1400 | image_tag: loading: 'lazy', alt: section.settings.product_title }}
      {% endif %}
      <div>
        <h2 style="text-align:left;margin-bottom:8px">{{ section.settings.product_title }}</h2>
        <div class="bd-price">
          {{ section.settings.product_price }}
          {% if section.settings.product_old != blank %}
            <span class="bd-old">{{ section.settings.product_old }}</span>
          {% endif %}
        </div>
        <p class="bd-note">{{ section.settings.product_note }}</p>
        <a class="bd-btn" href="/products/estrellita">{{ section.settings.product_btn }}</a>
      </div>
    </div>
  </section>

  <section class="bd-close">
    <h2>{{ section.settings.close_title }}</h2>
    <p>{{ section.settings.close_text }}</p>
    <a class="bd-btn" href="/products/estrellita">{{ section.settings.close_btn }}</a>
  </section>
</div>

{% schema %}
{
  "name": "Beludu Home",
  "settings": [
    { "type": "header", "content": "Barra superior" },
    { "type": "text", "id": "bar", "label": "Texto barra", "default": "Envío en Chile · Hecho a mano · +2.000 mamás" },

    { "type": "header", "content": "Hero" },
    { "type": "textarea", "id": "hero_title", "label": "Título", "default": "El traje que hace que tu bebé se vea como una estrellita." },
    { "type": "textarea", "id": "hero_text", "label": "Subtítulo", "default": "Hecho a mano. Suave de verdad. Para la foto que sí vas a mandar." },
    { "type": "text", "id": "hero_btn", "label": "Botón", "default": "Ver la Estrellita" },
    { "type": "url", "id": "hero_link", "label": "Link del botón" },
    { "type": "image_picker", "id": "img_hero", "label": "Imagen hero" },

    { "type": "header", "content": "Prueba social" },
    { "type": "text", "id": "trust", "label": "Texto", "default": "★★★★★ +2.000 mamás   ·   Envío rápido 🇨🇱   ·   Pago seguro   ·   30 días de garantía" },

    { "type": "header", "content": "Colores" },
    { "type": "text", "id": "colors_title", "label": "Título", "default": "Elige el color de tu estrellita" },
    { "type": "image_picker", "id": "img_colores", "label": "Imagen de colores" },

    { "type": "header", "content": "Por qué se lo quedan" },
    { "type": "text", "id": "why_title", "label": "Título", "default": "Por qué se lo quedan" },
    { "type": "image_picker", "id": "img_foto", "label": "Imagen 1" },
    { "type": "text", "id": "why_1_title", "label": "Título 1", "default": "Para la foto" },
    { "type": "text", "id": "why_1_text", "label": "Texto 1", "default": "Por fin una que sí mandas al grupo." },
    { "type": "image_picker", "id": "img_siesta", "label": "Imagen 2" },
    { "type": "text", "id": "why_2_title", "label": "Título 2", "default": "Para la siesta" },
    { "type": "text", "id": "why_2_text", "label": "Texto 2", "default": "Se queda rico. La capucha es lo que más gusta." },
    { "type": "image_picker", "id": "img_regalo", "label": "Imagen 3" },
    { "type": "text", "id": "why_3_title", "label": "Título 3", "default": "Para regalar" },
    { "type": "text", "id": "why_3_text", "label": "Texto 3", "default": "Llega lindo. No es otra manta más." },

    { "type": "header", "content": "Pasos" },
    { "type": "text", "id": "steps_title", "label": "Título", "default": "Cómo se usa" },
    { "type": "text", "id": "step_1", "label": "Paso 1", "default": "Eliges el color" },
    { "type": "text", "id": "step_2", "label": "Paso 2", "default": "Lo pides acá" },
    { "type": "text", "id": "step_3", "label": "Paso 3", "default": "Se lo pones" },
    { "type": "text", "id": "step_4", "label": "Paso 4", "default": "Sale la foto" },

    { "type": "header", "content": "Banner UGC" },
    { "type": "image_picker", "id": "img_ugc", "label": "Imagen collage" },

    { "type": "header", "content": "Testimonios" },
    { "type": "text", "id": "quotes_title", "label": "Título", "default": "Lo que más nos escriben" },
    { "type": "textarea", "id": "quote_1", "label": "Testimonio 1", "default": "Hola soy Javi, mamá soltera\nle compré este traje a mi hijo de 4 meses y le fascinó\nse lo puse pa la foto en el living y por fin tuve una que sí quise mandar" },
    { "type": "textarea", "id": "quote_2", "label": "Testimonio 2", "default": "Hola soy Antonia\nse lo puse un domingo, se quedó dormida en dos minutos\nmi mamá llegó, la vio y se largó a llorar" },
    { "type": "textarea", "id": "quote_3", "label": "Testimonio 3", "default": "Hola soy Matías, el papá\npor primera vez en semanas no lloró al vestirlo\nahora es el traje de las siestas raras de la tarde" },

    { "type": "header", "content": "Producto" },
    { "type": "image_picker", "id": "img_producto", "label": "Imagen producto" },
    { "type": "text", "id": "product_title", "label": "Nombre", "default": "Estrellita de Mar" },
    { "type": "text", "id": "product_price", "label": "Precio", "default": "$24.980" },
    { "type": "text", "id": "product_old", "label": "Precio anterior", "default": "$35.990" },
    { "type": "textarea", "id": "product_note", "label": "Detalle", "default": "Tejido a mano · 100% algodón\nTalla única 0 a 18 meses\nCrema, rosa, celeste, rojo y Patricio" },
    { "type": "text", "id": "product_btn", "label": "Botón", "default": "Elegir color" },

    { "type": "header", "content": "Cierre" },
    { "type": "textarea", "id": "close_title", "label": "Título", "default": "Si andas pensándolo, no lo dejes para después." },
    { "type": "text", "id": "close_text", "label": "Texto", "default": "La talla se le pasa." },
    { "type": "text", "id": "close_btn", "label": "Botón", "default": "Pedir la Estrellita" }
  ],
  "presets": [
    { "name": "Beludu Home" }
  ]
}
{% endschema %}